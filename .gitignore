node_modules/
npm-debug.log*
.env

# Собранный React-хаб — генерируется из client/ через `npm run build:client`,
# на сервере собирается заново, а не коммитится.
client/dist/

# Видео для фонового виджета — грузятся на сервер напрямую (scp/rsync),
# не через git: они большие и часто меняются, репозиторий не место для них.
public/videos/*
!public/videos/.gitkeep
